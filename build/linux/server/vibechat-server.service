# BuildY VibeChat server: the agent host, 127.0.0.1:18120 (API + Studio) and 127.0.0.1:18121 (preview gateway).
# Starts once a host token exists (`sudo -u vibechat vibechat-server token new`, run by the desktop app's setup).
[Unit]
Description=BuildY VibeChat server (agent host, loopback only)
Documentation=https://github.com/buildytech/vibechat-desktop
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/vibechat/auth/token.sha256

[Service]
User=vibechat
Group=vibechat
Environment=VIBECHAT_DATA_DIR=/var/lib/vibechat
Environment=PATH=/var/lib/vibechat/.bun/bin:/opt/vibechat/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/vibechat
# bun install and the dev server run in a bubblewrap jail without the data folder; never without it.
Environment=VIBECHAT_TOOLS_ISOLATION=require
ExecStart=/usr/bin/vibechat-server serve
StateDirectory=vibechat
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
# The agent's own sandbox (Landlock + bubblewrap user namespaces + seccomp) runs inside: no NoNewPrivileges /
# RestrictNamespaces here, they would switch it off.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
